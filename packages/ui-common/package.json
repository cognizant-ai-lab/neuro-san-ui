{
    "name": "@cognizant-ai-lab/ui-common",
    "description": "A shared UI component library for Cognizant AI Labs projects",
    "version": "1.12.0",
    "type": "module",
    "scripts": {
        "build": "yarn clean && yarn generate && yarn run --top-level tsc --project tsconfig.build.json && fix-esm-import-path dist > /dev/null",
        "clean": "rm -rf dist generated",
        "generate": "rm -rf generated && ./build_scripts/do_openapi_generate.sh",
        "prepack": "echo PREPACK_RUNNING && yarn build"
    },
    "dependencies": {
        "@dagrejs/dagre": "1.0.4",
        "@langchain/core": "catalog:default",
        "@xyflow/react": "catalog:default",
        "http-status": "catalog:default",
        "lodash-es": "catalog:default",
        "notistack": "catalog:default",
        "react-joyride": "catalog:default",
        "react-markdown": "catalog:default",
        "react-resizable-panels": "catalog:default",
        "react-syntax-highlighter": "16.1.0",
        "rehype-raw": "catalog:default",
        "rehype-slug": "catalog:default",
        "remark-gfm": "4.0.1",
        "uuid": "14.0.1",
        "zod": "catalog:default",
        "zustand": "4.5.7"
    },
    "devDependencies": {
        "@mui/icons-material": "catalog:default",
        "@mui/material": "catalog:default",
        "@mui/system": "catalog:default",
        "@mui/x-tree-view": "catalog:default",
        "@testing-library/dom": "catalog:default",
        "@testing-library/react": "catalog:default",
        "@testing-library/user-event": "catalog:default",
        "@types/lodash-es": "catalog:default",
        "@types/node": "catalog:default",
        "@types/react": "catalog:default",
        "@types/react-dom": "catalog:default",
        "@types/react-syntax-highlighter": "15.5.13",
        "fake-indexeddb": "catalog:default",
        "fix-esm-import-path": "1.10.3",
        "globals": "catalog:default",
        "openapi-typescript": "7.8.0",
        "react": "catalog:default",
        "react-dom": "catalog:default",
        "typescript": "catalog:default",
        "vitest": "catalog:default"
    },
    "peerDependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^7.3.1 || ^8.0.0 || ^9.0.0",
        "@mui/material": "^7.3.1 || ^8.0.0 || ^9.0.0",
        "@mui/system": "^7.3.1 || ^8.0.0 || ^9.0.0",
        "@mui/x-tree-view": "^8.22.0 || ^9.1.0",
        "next-auth": "^5.0.0-beta.29",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "peerDependenciesMeta": {
        "next-auth": {
            "optional": true
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cognizant-ai-lab/neuro-san-ui.git"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./const": {
            "types": "./dist/const.d.ts",
            "import": "./dist/const.js"
        },
        "./controller/*": {
            "types": "./dist/controller/*.d.ts",
            "import": "./dist/controller/*.js"
        },
        "./components/*": {
            "types": "./dist/components/*.d.ts",
            "import": "./dist/components/*.js"
        },
        "./state/*": {
            "types": "./dist/state/*.d.ts",
            "import": "./dist/state/*.js"
        },
        "./utils/*": {
            "types": "./dist/utils/*.d.ts",
            "import": "./dist/utils/*.js"
        },
        "./Theme/*": {
            "types": "./dist/Theme/*.d.ts",
            "import": "./dist/Theme/*.js"
        }
    },
    "files": [
        "dist"
    ]
}
